@OdataSample_HostAddress = http://localhost:5172

//A sample request to test the OData parameters

GET {{OdataSample_HostAddress}}/odata/DailyForecasts?$filter=1%20eq%201
Accept: application/json

###
//A sample of a batch request with a single GET operation - the odata parameters are sent in the request body, not in the URL. 
//This is a workaround for sending a large parameter list in a GET request, which can exceed the maximum URL length limit.

POST http://localhost:5172/odata/$batch  HTTP/1.1
Content-Type: multipart/mixed; boundary=batch_123

--batch_123
Content-Type: application/http
Content-Transfer-Encoding: binary

GET /odata/DailyForecasts?$filter=Temp%20gt%2020 HTTP/1.1
Accept: application/json

--batch_123--

###
